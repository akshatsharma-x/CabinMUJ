# Copy to .env.local (for local development) or set these in your host's environment.

# Admin login for /admin (required for the admin panel)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs the admin session cookie. Use a long random string, e.g. `openssl rand -hex 32`.
# Optional: if unset, a secret is derived from the username and password.
ADMIN_SESSION_SECRET=

# Where students' "Email an update" messages go.
NEXT_PUBLIC_CONTACT_EMAIL=cabinmuj@gmail.com

# Optional: folder for the data file (default: ./data). Must be writable and persistent.
# CABINMUJ_DATA_DIR=/var/lib/cabinmuj
